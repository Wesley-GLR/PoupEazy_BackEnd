{
  "name": "poupeazy-backend",
  "version": "1.0.0",
  "description": "Backend proprio do PoupEazy (auth + banco + Open Finance), substituindo o Supabase.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1",
    "check": "npm test && npm audit --audit-level=high",
    "db:init": "node scripts/init-db.js",
    "db:migrate:whatsapp": "node scripts/migrate-whatsapp.js",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f api"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pluggy-sdk": "^0.85.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
