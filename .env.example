# Porta em que a API roda (o frontend chama http://localhost:3001/api)
PORT=3001

# Conexao com o PostgreSQL.
# Local (docker-compose): postgres://poupeazy:poupeazy@localhost:5432/poupeazy
# Nuvem (Neon): cole a connection string fornecida pelo painel (com ?sslmode=require)
DATABASE_URL=postgres://poupeazy:poupeazy@localhost:5432/poupeazy

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatorio)
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=7d

# development | production
# Em development, /auth/forgot-password retorna o token de reset no corpo da resposta.
NODE_ENV=development

# Origem(ns) permitida(s) no CORS, separadas por virgula. Use * para liberar tudo (apenas dev).
CORS_ORIGIN=*

# Credenciais da Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui
