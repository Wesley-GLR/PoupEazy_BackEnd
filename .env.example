# Porta em que a API roda (o frontend chama http://localhost:3001/api)
PORT=3001

# Conexao com o PostgreSQL.
# Local (docker-compose): postgres://poupeazy:poupeazy@localhost:5432/poupeazy
# Nuvem (Neon): cole a connection string fornecida pelo painel (com ?sslmode=require)
DATABASE_URL=postgres://poupeazy:poupeazy@localhost:5432/poupeazy

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatorio)
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=7d

# development | production
# Em development, /auth/forgot-password retorna o token de reset no corpo da resposta.
NODE_ENV=development

# Origem(ns) permitida(s) no CORS, separadas por virgula. Use * para liberar tudo (apenas dev).
CORS_ORIGIN=*

# Protecoes HTTP e conexao. Os valores abaixo sao defaults seguros para uso local.
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false
DATABASE_SSL=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Credenciais da Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui

# Opcional: URI autorizada no painel Pluggy para concluir OAuth no app/site.
# PLUGGY_OAUTH_REDIRECT_URI=poupeazy://open-finance/callback
PLUGGY_SYNC_MAX_TRANSACTIONS=10000

# WhatsApp, opcional. Escolha meta ou vonage_sandbox.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta

# WhatsApp Cloud API da Meta
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOT_NUMBER=
# Opcional: celular BR cadastrado na lista de teste, com +55 e nono dígito (só números).
WHATSAPP_TEST_RECIPIENT_BR=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Vonage Messages API Sandbox. Número do remetente, só dígitos.
VONAGE_WHATSAPP_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
# Opcional: origem HTTPS pública do webhook para imagens temporárias dos relatórios.
VONAGE_MEDIA_BASE_URL=
